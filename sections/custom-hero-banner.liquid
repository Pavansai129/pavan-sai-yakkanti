{{ 'custom-hero-banner.css' | asset_url | stylesheet_tag }}

<style>
  .section-padding-{{ section.id }}{
    padding-top:{{ section.settings.padding_top_mobile }}px;
    padding-bottom:{{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width:750px){
    .section-padding-{{ section.id }}{
      padding-top:{{ section.settings.padding_top_desktop }}px;
      padding-bottom:{{ section.settings.padding_bottom_desktop }}px;
    }
  }
  {%- for block in section.blocks -%}
    {%- if block.type == 'image_with_text' -%}
      .custom-hero-banner__image-text-wrapper-{{ block.id }} .custom-hero-banner__heading p {
        color: {{ block.settings.heading_color }};
      }
      .custom-hero-banner__image-text-wrapper-{{ block.id }} .custom-hero-banner__description {
        color: {{ block.settings.description_color }}
      }
      .custom-hero-banner__image-text-wrapper-{{ block.id }} .custom-hero-banner__button {
        color: {{ block.settings.button_text_color }};
        background: {{ block.settings.button_bg }};
      }
      .custom-hero-banner__image-text-wrapper-{{ block.id }} .custom-hero-banner__button::before {
        background: {{ block.settings.button_bg_hover }};
      }
      .custom-hero-banner__image-text-wrapper-{{ block.id }} .custom-hero-banner__button .button-arrow svg path {
        color: {{ block.settings.button_icon_color }};
        fill: {{ block.settings.button_icon_color }};
      }
      .custom-hero-banner__image-text-wrapper-{{ block.id }} .custom-hero-banner__button:hover {
        color: {{ block.settings.button_text_hover }};
      }
      .custom-hero-banner__image-text-wrapper-{{ block.id }} .custom-hero-banner__button:hover .button-arrow svg path {
        color: {{ block.settings.button_icon_hover }};
        fill: {{ block.settings.button_icon_hover }};
      }
    {% elsif block.type == 'annoucement' %}
      .custom-hero-banner__annocement-{{  block.id }} {
        background: {{ block.settings.annoucement_bg_color }};
      }
      .custom-hero-banner__annocement-{{  block.id }} .custom-hero-banner__annocement {
        color: {{ block.settings.annoucement_text_color }};
      }
    {%- endif -%}
  {%- endfor -%}
</style>

<div class="custom-hero-banner custom-hero-banner-{{ section.id }} section-padding-{{ section.id }}">
  <div class="custom-hero-banner-wrapper {% if section.settings.section_width == "page_width" %}page-width{% endif %}">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'image' %}
            <div class="custom-hero-banner__image-wrapper">
              {% unless block.settings.hide_mobile_image %}
                {% if block.settings.mobile_image != blank %}
                  <div class="custom-hero-banner__image medium-hide large-up-hide">
                    <img
                      src="{{ block.settings.mobile_image | image_url }}"
                      width="100%"
                      height="auto"
                      alt="{{ block.settings.mobile_image.alt }}"
                    >
                  </div>
                {% else %}
                  <div class="custom-hero-banner__image medium-hide large-up-hide">
                    {{ 'hero-apparel-2' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              {% endunless %}
              {% if block.settings.desktop_image != blank %}
                <div class="custom-hero-banner__image-wrapper small-hide">
                  <img
                    src="{{ block.settings.desktop_image | image_url }}"
                    width="100%"
                    height="auto"
                    alt="{{ block.settings.desktop_image.alt }}"
                  >
                </div>
              {% else %}
                <div class="custom-hero-banner__image-wrapper small-hide">
                  {{ 'hero-apparel-2' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

          {% when 'image_with_text' %}
            {% capture button %}
                {% if block.settings.button_url != blank %}
                  <a href="{{ block.settings.button_url }}" class="custom-hero-banner__link">
                    <button class="custom-hero-banner__button">
                        <span class="button-text">{{ block.settings.button_text }}</span>
                        <span class="button-arrow">{% render 'icons' icon_name: "right-arrow" %}</span>
                    </button>
                  </a>
                {% else %}
                  <button class="custom-hero-banner__button" disabled>
                      <span class="button-text">{{ block.settings.button_text }}</span>
                      <span class="button-arrow">{% render 'icons' icon_name: "right-arrow" %}</span>
                  </button>
                {% endif %}
            {% endcapture %}
            <div class="custom-hero-banner__image-text-wrapper custom-hero-banner__image-text-wrapper-{{ block.id }}" {{ block.shopify_attributes }}>
              <div class="custom-hero-banner__text-container">
                <div class="custom-hero-banner__mobile-text-container medium-hide large-up-hide">
                  {% if block.settings.mobile_heading != blank %}
                    <h2 class="custom-hero-banner__heading">
                      {{ block.settings.mobile_heading }}
                    </h2>
                  {% endif %}
                  {% if block.settings.mobile_description != blank %}
                    <p class="custom-hero-banner__description">
                      {{ block.settings.mobile_description }}
                    </p>
                  {% endif %}
                  {% if button %}
                    <div class="custom-hero-banner__button-container {% if block.settings.show_button_on_image_mobile %}small-hide{% endif %}">
                      {{ button }}
                    </div>
                  {% endif %}
                </div>
                <div class="custom-hero-banner__desktop-text-container small-hide">
                  {% if block.settings.desktop_heading != blank %}
                    <h2 class="custom-hero-banner__heading">
                      {{ block.settings.desktop_heading }}
                    </h2>
                  {% endif %}
                  {% if block.settings.desktop_description != blank %}
                    <p class="custom-hero-banner__description">
                      {{ block.settings.desktop_description }}
                    </p>
                  {% endif %}
                  {% if button %}
                    <div class="custom-hero-banner__button-container">
                      {{ button }}
                    </div>
                  {% endif %}
                </div>
              </div>
              <div class="custom-hero-banner__image-container">
                {% if block.settings.mobile_image != blank %}
                  <div class="custom-hero-banner__mobile-image medium-hide large-up-hide">
                    <img
                      src="{{ block.settings.mobile_image | image_url }}"
                      width="100%"
                      height="auto"
                      alt="{{ block.settings.mobile_image.alt }}"
                    >
                  </div>
                {% else %}
                  <div class="custom-hero-banner__mobile-image medium-hide large-up-hide">
                    {{ 'hero-apparel-2' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                {% if block.settings.desktop_image != blank %}
                  <div class="custom-hero-banner__desktop-image small-hide">
                    <img
                      src="{{ block.settings.desktop_image | image_url }}"
                      width="100%"
                      height="auto"
                      alt="{{ block.settings.desktop_image.alt }}"
                    >
                  </div>
                {% else %}
                  <div class="custom-hero-banner__desktop-image small-hide">
                    {{ 'hero-apparel-2' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                {% if button %}
                  <div class="custom-hero-banner__button_on_image {% if block.settings.show_button_on_image_mobile %}medium-hide large-up-hide{% else %} hidden {% endif %}">
                    {{ button }}
                  </div>
                {% endif %}
              </div>
            </div>
          {% when 'annoucement' %}
            {% if block.settings.annoucement_desktop_heading != blank
              or block.settings.annoucement_mobile_heading != blank
            %}
              <div class="custom-hero-banner__annocement custom-hero-banner__annocement-{{  block.id }} page-width" {{ block.shopify_attributes }}>
                <div class="custom-hero-banner__annocement-wrapper">
                  {% if block.settings.annoucement_desktop_heading != blank %}
                    <div class="custom-hero-banner__annocement-container small-hide">
                      {{ block.settings.annoucement_desktop_heading }}
                    </div>
                  {% endif %}
                  {% if block.settings.annoucement_mobile_heading != blank %}
                    <div class="custom-hero-banner__annocement-container medium-hide large-up-hide">
                      {{ block.settings.annoucement_mobile_heading }}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
        {% endcase %}
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Custom Hero Banner",
  "class": "custom-hero-banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "full_width",
          "label": "Full width"
        },
        {
          "value": "page_width",
          "label": "Page width"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "header",
      "content": "Section padding settings"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (Desktop)",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 1,
      "default": 90
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (Desktop)",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 1,
      "default": 90
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (Mobile)",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 1,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (Mobile)",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 1,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "image_with_text",
      "limit": 1,
      "name": "Image with text",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "If you want to display the same image for mobile, upload the desktop image here as well."
        },
        {
          "type": "text",
          "id": "desktop_heading",
          "label": "Heading (Desktop)",
          "default": "The Gift Guide"
        },
        {
          "type": "text",
          "id": "desktop_description",
          "label": "Description (Desktop)",
          "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
        },
        {
          "type": "text",
          "id": "mobile_heading",
          "label": "Heading (Mobile)",
          "default": "The Gift Guide"
        },
        {
          "type": "text",
          "id": "mobile_description",
          "label": "Description (Mobile)",
          "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        },
        {
          "type": "checkbox",
          "id": "show_button_on_image_mobile",
          "label": "Show button on Image (Mobile)",
          "default": true
        },
        {
          "type": "header",
          "content": "Color settings"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "description_color",
          "label": "Description color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "button_bg",
          "label": "Button background",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button text color",
          "default": "#F5F5F5"
        },
        {
          "type": "color",
          "id": "button_icon_color",
          "label": "Button icon color",
          "default": "#F5F5F5"
        },
        {
          "type": "color",
          "id": "button_bg_hover",
          "label": "Button background hover",
          "default": "#FFF544"
        },
        {
          "type": "color",
          "id": "button_text_hover",
          "label": "Button text hover",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "button_icon_hover",
          "label": "Button icon hover",
          "default": "#000000"
        }
      ]
    },
    {
      "type": "image",
      "limit": 1,
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "If you want to display the same image for mobile, upload the desktop image here as well."
        },
        {
          "type": "checkbox",
          "id": "hide_mobile_image",
          "label": "Hide mobile image",
          "default": true
        }
      ]
    },
    {
      "type": "annoucement",
      "limit": 1,
      "name": "Annocement",
      "settings": [
        {
          "type": "richtext",
          "id": "annoucement_desktop_heading",
          "label": "Heading (Desktop)",
          "default": "<p>SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL</p>"
        },
        {
          "type": "richtext",
          "id": "annoucement_mobile_heading",
          "label": "Heading (Mobile)",
          "default": "<p>SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR</p>"
        },
        {
          "type": "color",
          "id": "annoucement_text_color",
          "label": "Text color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "annoucement_bg_color",
          "label": "BG color",
          "default": "#000000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Hero banner",
      "category": "Custom",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image_with_text"
        }
      ]
    }
  ]
}
{% endschema %}
